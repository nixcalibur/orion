# Required
OPENAI_API_KEY=sk-...

# Optional — external review API delivery target
REVIEW_API_URL=https://httpbin.org/post

# Optional — pipeline timeout for serverless handler (seconds)
PIPELINE_TIMEOUT_SECONDS=270

# Optional — authorization thresholds (defaults shown)
# ORION_THRESHOLD_REJECT=9.0
# ORION_THRESHOLD_DEFER=4.5
# ORION_THRESHOLD_CONDITIONAL=2.0

# Optional — extraction passes merged by majority vote (default: 3; 1 = single-pass)
# ORION_EXTRACTION_VOTES=3

# Optional — shared secret for FastAPI assessment routes (Bearer or X-API-Key).
# Unset/empty = open local access. /health is always open.
# ORION_API_KEY=
